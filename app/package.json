{
  "name": "app",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0 <24"
  },
  "scripts": {
    "predev": "node ../scripts/build-registry.mjs",
    "dev": "PUBLIC_SHOW_PRIVATE=1 astro dev",
    "pretest:watch": "node ../scripts/build-registry.mjs",
    "build": "node ../scripts/build-registry.mjs && node scripts/stage-fixtures.mjs && node --experimental-strip-types scripts/build-lemmata.mjs && astro build && node scripts/postbuild-robots.mjs && node scripts/postbuild-sw.mjs",
    "build:lemmata": "node --experimental-strip-types scripts/build-lemmata.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "shots": "node scripts/shoot.mjs",
    "pretest": "node ../scripts/build-registry.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.2"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^14.3.1",
    "@astrojs/svelte": "^9.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.2.9",
    "axe-core": "^4.10.3",
    "happy-dom": "^20.0.10",
    "js-yaml": "^4.2.0",
    "svelte": "^5.56.3",
    "vitest": "^4.0.16",
    "wrangler": "^4.131.2"
  }
}
