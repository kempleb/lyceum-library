---
// The Latin Lexicon index at /lemma/lat — the sibling of lemma/grc/index.astro
// (Wave 2 Batch 1a scaffold). Reads public/data/lemmata-lat.json, which
// scripts/build-lemmata.mjs does not produce yet (Cicero's De Officiis ships
// `lexicon: false` — no Latin lemma data at all until Batch 1b wires Lewis &
// Short), so this page renders correctly with zero entries today: an honest
// "coming soon" state, not a build failure.
import { readFileSync } from 'node:fs';
import ThemeInit from '../../../components/ThemeInit.astro';
import ThemeToggle from '../../../components/ThemeToggle.astro';
import Pwa from '../../../components/Pwa.astro';
import { jsonLdSafe } from '../../../lib/jsonld';
import LyceumBand from '../../../components/LyceumBand.astro';
import { siteNameFor } from '../../../lib/site';
import '@shared/styles/global.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// PUBLIC_LYCEUM_CHROME=1 puts the sitewide Lyceum band and name on this page
// too (docs/design-spec.md §4), so the demo origin reads as one site; with the
// flag off every line below is the page this route has always served.
const lyceumChrome = import.meta.env.PUBLIC_LYCEUM_CHROME === '1';
const siteName = siteNameFor(lyceumChrome);


let manifest: Record<string, { slug: string; head: string; count: number }> = {};
try {
  manifest = JSON.parse(readFileSync('public/data/lemmata-lat.json', 'utf-8'));
} catch { /* no Latin lexicon data built yet (Batch 1b) */ }
const entries = Object.values(manifest)
  .map((e) => ({ ...e, fold: e.head.toLowerCase() }))
  .sort((a, b) => a.slug.localeCompare(b.slug));

const pageTitle = `Latin Lexicon — Word Frequency & Concordance — ${siteName}`;
const metaDescription = entries.length
  ? `A growing lexicon of the corpus's Latin vocabulary: ${entries.length} key terms with` +
    ` Lewis & Short definitions, corpus-wide frequency counts, and every occurrence linked to the` +
    ` parallel Latin–English text.`
  : `The Latin lexicon (Lewis & Short click-to-parse) is coming in a future update — Latin texts` +
    ` are already readable in the parallel reader.`;
const canonical = Astro.site ? new URL(`${base}/lemma/lat/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: 'Latin Lexicon',
  description: metaDescription,
  ...(canonical ? { url: canonical } : {}),
  hasDefinedTerm: entries.slice(0, 100).map((e) => ({
    '@type': 'DefinedTerm', name: e.head, inLanguage: 'la',
    ...(canonical ? { url: new URL(`${base}/lemma/lat/entry/?w=${e.slug}`, Astro.site!).href } : {}),
  })),
};
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:site_name" content={siteName} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={metaDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <style>
    .lxi-body { max-width: 900px; margin: 0 auto; padding: 2rem 1rem 5rem; font-family: var(--font-english); color: var(--text); }
    .lxi-h1 { font-size: 1.8rem; font-weight: 600; margin: 0 0 0.4rem; }
    .lxi-lede { color: var(--text-mid); line-height: 1.6; margin: 0 0 1.2rem; max-width: 60ch; }
    .lxi-filter { display: flex; align-items: center; gap: 0.7rem; margin: 0 0 1.4rem; position: sticky; top: 0; z-index: 5; background: var(--col-bg); padding: 0.5rem 0; }
    .lxi-filter input {
      flex: 1 1 auto; min-width: 0; font-family: var(--font-ui); font-size: 1rem;
      padding: 0.55rem 0.8rem; color: var(--text); background: var(--surface, var(--col-bg));
      border: 1px solid var(--border); border-radius: 8px;
    }
    .lxi-filter input:focus { outline: none; border-color: var(--accent); }
    .lxi-count { font-family: var(--font-ui); font-variant-numeric: tabular-nums; font-size: 0.82rem; color: var(--text-mid); white-space: nowrap; }
    .lxi-empty { color: var(--text-mid); font-size: 0.95rem; margin: 1rem 0; }
    .lxi-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr)); gap: 0.4rem; list-style: none; padding: 0; margin: 0; }
    .lxi-grid a { display: flex; justify-content: space-between; gap: 0.6rem; align-items: baseline; text-decoration: none; color: var(--text); border: 1px solid var(--border); border-radius: 6px; padding: 0.5rem 0.7rem; }
    .lxi-grid a:hover { border-color: var(--accent); }
    .lxi-gk { font-family: var(--font-latin); font-size: 1.05rem; }
    .lxi-n { font-variant-numeric: tabular-nums; font-size: 0.78rem; color: var(--text-mid); }
  </style>
  <Pwa />
</head>
<body class={lyceumChrome ? 'lyceum-chrome lyc-page' : undefined}>
  {lyceumChrome ? (
    <div class="lyc-chrome">
      <LyceumBand siteName={siteName} searchHref={`${base}/search`}>
        <a class="tool" href={`${base}/catalog/`}>Catalog</a>
        <a class="tool" href={`${base}/lemma/lat/`}>Lexica</a>
        <ThemeToggle />
        <a class="tool tool-signin" href="https://lyceum.institute">Sign in</a>
      </LyceumBand>
    </div>
  ) : (
  <header class="simple-header">
    <div class="header-title">
      <a class="home-link" href={`${base}/`}>Home</a>
      <span class="title-sep">›</span>
      <span class="header-static">Latin Lexicon</span>
    </div>
    <nav class="header-actions" aria-label="Navigation">
      <a href={`${base}/`} class="search-link">All works</a>
      <a href={`${base}/search`} class="search-link">Search</a>
      <ThemeToggle />
    </nav>
  </header>
  )}
  <main class="lxi-body">
    <h1 class="lxi-h1">Latin Lexicon</h1>
    {entries.length > 0 ? (
      <>
        <p class="lxi-lede">
          {entries.length} key terms from the corpus's Latin vocabulary — each with its Lewis &amp; Short
          definition, how often it appears across the corpus, and every occurrence linked to the parallel
          Latin–English text. A concordance you can read.
        </p>
        <div class="lxi-filter">
          <input
            type="search"
            id="lxi-input"
            placeholder="Filter — type a Latin word…"
            autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false"
            aria-label="Filter the lexicon by Latin word"
          />
          <span class="lxi-count" id="lxi-count" aria-live="polite"></span>
        </div>
        <ul class="lxi-grid" id="lxi-grid">
          {entries.map((e) => (
            <li data-fold={e.fold}>
              <a href={`${base}/lemma/lat/entry/?w=${e.slug}`}>
                <span class="lxi-gk">{e.head}</span>
                <span class="lxi-n">{e.count.toLocaleString()}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="lxi-empty" id="lxi-empty" hidden>No entries match.</p>
      </>
    ) : (
      <p class="lxi-lede">
        Click-to-parse for Latin (Lewis &amp; Short definitions, word frequency, concordance) is coming
        in a future update. Latin texts — currently Cicero's <em>De Officiis</em> — are already readable
        in the parallel reader with full citation and search.
      </p>
    )}
  </main>

  {entries.length > 0 && (
    <script>
      const fold = (s: string) => s.toLowerCase().replace(/[^a-z]/g, '');
      const input = document.getElementById('lxi-input') as HTMLInputElement | null;
      const grid = document.getElementById('lxi-grid');
      const countEl = document.getElementById('lxi-count');
      const emptyEl = document.getElementById('lxi-empty');
      if (input && grid) {
        const items = Array.from(grid.querySelectorAll<HTMLLIElement>('li'));
        const total = items.length;
        const apply = () => {
          const q = fold(input.value.trim());
          let shown = 0;
          for (const li of items) {
            const hit = !q || (li.dataset.fold ?? '').startsWith(q);
            li.hidden = !hit;
            if (hit) shown++;
          }
          if (countEl) countEl.textContent = q ? `${shown} of ${total}` : '';
          if (emptyEl) emptyEl.hidden = shown !== 0;
        };
        input.addEventListener('input', apply);
      }
    </script>
  )}
</body>
</html>
